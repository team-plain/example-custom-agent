# Plain API key for the machine user this agent runs as.
PLAIN_API_KEY=

# Workspace webhook signing secret: Plain → Settings → Request Signing.
PLAIN_WEBHOOK_SECRET=

# The public https URL that reaches this process: your ngrok URL locally, or wherever you deploy it.
PUBLIC_URL=

# Optional. Set to 1 to have the agent resolve the discussion after it answers. Off by default: this
# example cannot tell a finished conversation from a pause, and resolving a live one hides it from
# the customer.
PLAIN_RESOLVE_WHEN_DONE=

# Where the agent CLI runs: local (the default) or vercel-sandbox. Locally it runs on this machine,
# with this machine's filesystem in reach.
AGENT_RUNTIME=

# Required by AGENT_RUNTIME=vercel-sandbox: a Vercel access token, and the team and project the
# sandboxes belong to.
VERCEL_BEARER_TOKEN=
VERCEL_SANDBOX_TEAM_ID=
VERCEL_SANDBOX_PROJECT_ID=

# Optional. A snapshot that already has the claude CLI in it. Without one, every new sandbox
# installs the CLI at first start, which the discussion's first turn waits for.
VERCEL_SANDBOX_SNAPSHOT_ID=

# Required by AGENT_RUNTIME=vercel-sandbox. A sandbox holds none of your local logins, so the CLI
# authenticates from the environment instead. ANTHROPIC_AUTH_TOKEN works too, for a gateway.
ANTHROPIC_API_KEY=
