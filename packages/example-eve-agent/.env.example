# Plain API key for the machine user this agent runs as. Needs the Custom agent toggle on, plus
# threadDiscussion:read, threadDiscussion:edit, threadDiscussionMessage:create and
# threadDiscussionMessage:edit.
PLAIN_API_KEY=

# Workspace webhook signing secret: Plain → Settings → Request Signing.
PLAIN_WEBHOOK_SECRET=

# Optional. Overrides the Plain API endpoint, which defaults to production.
PLAIN_API_URL=

# The model credential. eve's default model is a string id routed through the Vercel AI Gateway,
# which needs this. `eve link` pulls a VERCEL_OIDC_TOKEN instead, and a direct provider model needs
# that provider's own key. See the README.
AI_GATEWAY_API_KEY=
