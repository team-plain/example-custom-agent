# Plain API key for the machine user this agent runs as. This file overrides the shell environment
# on purpose: a stale exported PLAIN_API_KEY silently runs the agent as a different machine user.
PLAIN_API_KEY=

# Workspace webhook signing secret: Plain dashboard -> Settings -> Webhooks -> Signing secret.
# An API key cannot read this (the query is human-user only), so it has to be pasted here.
PLAIN_WEBHOOK_SECRET=

# The public https URL that reaches this process: your ngrok URL locally, or wherever you deploy it.
PUBLIC_URL=

PORT=8081

# Claude Code uses its own logged-in session, so do not put an Anthropic key here.
# Claude runs unconfined: auto mode approves its own tool calls and the sandbox is off.
CLAUDE_PERMISSION_MODE=auto
CLAUDE_TIMEOUT_SECONDS=180

# Optional. Defaults shown.
# PLAIN_API_URL=https://core-api.uk.plain.com/graphql/v1
# CLAUDE_BIN=claude
# CLAUDE_CWD=            # where Claude starts. It can reach the whole filesystem regardless
# AGENT_WORKDIR=./workdir  # where sessions.json lives
