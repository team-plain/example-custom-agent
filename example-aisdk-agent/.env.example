# Plain API key for the machine user this agent runs as. The two surfaces need different
# permissions: see the README for which.
PLAIN_API_KEY=

# Workspace webhook signing secret: Plain → Settings → Request Signing.
PLAIN_WEBHOOK_SECRET=

# Required. Unlike the other packages, this one calls the model itself rather than driving a CLI
# or a framework.
OPENAI_API_KEY=

# Optional. Overrides the Plain API endpoint, which defaults to production.
PLAIN_API_URL=

# Optional. Defaults to gpt-4o-mini.
AGENT_MODEL=

# Optional. Set either to 0 to run only one surface. Both are on by default, because comparing
# them is the point of this package.
PLAIN_SURFACE_SUPPORT=
PLAIN_SURFACE_INTERNAL=

# Optional. The human gates, on by default on both surfaces. SUPPORT=0 sends replies to customers
# instead of drafting them for review; INTERNAL=0 skips the approval card.
PLAIN_GATE_SUPPORT=
PLAIN_GATE_INTERNAL=
